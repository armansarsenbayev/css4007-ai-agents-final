# Copy this file to .env and fill it in. .env is gitignored: never commit a real key.
# LLM_API_KEY is required. OPENAI_API_KEY is also accepted as a fallback.
LLM_API_KEY=
# Model name. Default: gpt-5.6-luna
LLM_MODEL=gpt-5.6-luna
# Optional OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1 (leave empty for OpenAI).
LLM_BASE_URL=
# gpt-5.6-luna only accepts tool calls with reasoning_effort=none. Leave empty to not send the parameter.
LLM_REASONING_EFFORT=none
